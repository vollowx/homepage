---
import Layout from '../layouts/Layout.astro'
import { toViewTransitionName } from '../utils/css.ts';

const allPosts = Object.values(import.meta.glob('./blog/*.md', { eager: true }))
  .sort((a: any, b: any) => {
    return new Date(b.frontmatter.pubDate).getTime()
      - new Date(a.frontmatter.pubDate).getTime();
  });
---

<Layout title="Vollow's homepage">
  <section>
    <h1>Hi! It's Vollow here</h1>
    <p class="metadata desc">
      <noscript>
        My timezone is UTC+8
      </noscript>
      <span class="dynamic-time"></span>
      <script is:inline>
        const $time = document.querySelector('.dynamic-time');

        const queryTime = () => {
          return new Date().toLocaleString('en-US', {
            timeZone: 'Asia/Shanghai',
            hour: 'numeric',
            minute: 'numeric',
            second: 'numeric',
            hourCycle: 'h23',
          })
        };

        const displayTime = () =>
          $time.textContent = 'It\'s ' + queryTime() + ' now in my timezone';

        displayTime();
        setTimeout(() => {
          displayTime();
          setInterval(displayTime, 1000);
        }, 1000 - new Date().getMilliseconds());
      </script>
    </p>
    <p>My name is Lucas X. <span class="small-caps">Zhao</span> (also known as Vollow).</p>
    <p>
      I'm a self-taught developer interested in program accessibility, web
      components and networks.
      I mainly code in C, Go, Zig and frontend stuffs, out of my personal
      interests.
      You can find some of my programs on
      <a href="https://sr.ht/~lucaz/">SourceHut</a> and
      <a href="https://github.com/vollowx/">GitHub</a>.
    </p>
  </section>
  <section>
    <h2>Projects</h2>
    <dl>
      <dt><a href="./seele/">seele</a></dt>
      <dd>
        An extensible Web Components library, with Material Design 3 components
        pre-provided.
      </dd>

      <dt><a href="https://github.com/vollowx/gotodo/">gotodo</a></dt>
      <dd>Todo manager with cli and web interface.</dd>

      <dt><a href="./wp-swayidle/">wp-swayidle</a></dt>
      <dd>
        <a href="http://github.com/swaywm/swayidle">swayidle</a> manager, kills
        it when there is an audio output.
      </dd>

      <dt><a href="./charwild/">charwild</a></dt>
      <dd>Unfinished survival game, in the terminal.</dd>

      <dt><a href="https://github.com/vollowx/bilibili-catppuccin/">
        bilibili-catppuccin</a></dt>
      <dd>Catppuccin userstyle for BiliBili.</dd>

      <dt><a href="https://github.com/catppuccin/nvim/">catppuccin/nvim</a></dt>
      <dd>Catppuccin colorscheme for Neovim (as a maintainer).</dd>

      <dt><a href="https://vue.misaka-fans.space/">misaka-fans</a></dt>
      <dd>Fan website for Misaka Mikoto (as a collaborator).</dd>
    </dl>

    <h2>Contact</h2>
    <ul>
      <li><a href="mailto:vollowx@outlook.com">vollowx@outlook.com</a></li>
      <li><a href="https://bsky.app/profile/vollowx.bsky.social">Bluesky</a></li>
    </ul>

    <h2>Writings</h2>
    <dl>
      {
        allPosts.slice(0,3).map((post: any) => (
          <dt>
            <a href={post.url} style={'view-transition-name: post-title-'
              + toViewTransitionName(post.frontmatter.title)}>
              {post.frontmatter.title}
            </a>
          </dt>
          <dd>{post.frontmatter.description}</dd>
          <dd>{post.frontmatter.pubDate.toString().slice(0, 7)}</dd>
        ))
      }
    </dl>
    <p><a href="/blog/">View all posts</a></p>

    <h2>Others</h2>
    <ul>
      <li><a href="/vollow.asc">OpenGPG key</a></li>
      <li><a href="https://files.tideover.cc/public/">File server (read-only)</a></li>
      <li><a href="/blogroll/">Blogroll</a></li>
    </ul>
  </section>
</Layout>
